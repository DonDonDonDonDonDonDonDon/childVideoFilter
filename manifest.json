{
  "manifest_version": 3,
  "name": "Child Video Filter",
  "version": "1.3",
  "description": "這個擴充功能可以幫助家長過濾掉不適合兒童觀看的影片，保護孩子的身心健康。",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://img.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com.tw/*",
        "*://*.youtube.com/watch*",
        "*://*.youtube.com/shorts/*"
      ],
      "js": [
        "execute.js"
      ],
      "run_at": "document_start"
    }
  ]
}