{
  "manifest_version": 3,
  "name": "我的第一個 Chrome 插件",
  "version": "1.1",
  "description": "這是一個簡單的範例插件",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com.tw/*"
      ],
      "js": [
        "execute.js"
      ]
    }
]}